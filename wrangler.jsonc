{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gelmatic-website",
  "compatibility_date": "2026-10-01",
  // Static site: Cloudflare serves the Next.js export in ./out directly, no Worker code needed.
  "assets": {
    "directory": "./out/",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": { "enabled": true },
  // Live domains: Cloudflare creates the DNS records and certificates on deploy.
  "routes": [
    { "pattern": "gelmatic.co.uk", "custom_domain": true },
    { "pattern": "www.gelmatic.co.uk", "custom_domain": true }
  ]
  // Dev address (still on): https://gelmatic-website.justin-b8f.workers.dev
}
